# Names only, never values. On the server: cp infra/env.example .env && chmod 600 .env, then fill it in by hand from Bitwarden.
# Each server has its own secrets. Nothing comes from the laptop's .env.

# Required from M7a on. infra/bootstrap.sh refuses to start if any of these is empty.
POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=
# Write-only pre-authenticated URL of the backup bucket, ending in /o/
BACKUP_PAR_URL=
# Healthchecks.io ping URL of the m7-server-backup check. The UUID is its only credential: treat it as a secret.
BACKUP_HEARTBEAT_URL=
# Healthchecks.io ping URL of the m7-demo-reset check (M7c-2), pinged by infra/demo-reset.sh after a successful reset. A secret, like the one above.
DEMO_RESET_HEARTBEAT_URL=

# Password of the n8n_app role (migration 007). Read only by scripts\check-db-role.ps1; n8n gets it through its credential. Letters and digits only.
N8N_DB_PASSWORD=

# The whsec_ of the server's own Stripe webhook endpoint (M7b-5). Read only by the host-side test scripts, which sign test requests;
# n8n never gets it as a variable: it uses the same value from its crypto credential "Stripe webhook secret". Rotate both together.
STRIPE_WEBHOOK_SECRET=

# Not here on purpose: TELEGRAM_CHAT_ID, ALERT_EMAIL_TO, ALERT_EMAIL_FROM, INVOICE_EMAIL_FROM, TELEGRAM_SEND_PDF and the heartbeat URL
# live in the n8n data tables stripe_config and stripe_heartbeat, because workflows cannot read the environment (M7b-3).

# Names only, never values. On the server: cp infra/env.example .env && chmod 600 .env, then fill it in by hand from Bitwarden.
# Each server has its own secrets. Nothing comes from the laptop's .env.

# Required from M7a on. infra/bootstrap.sh refuses to start if any of these is empty.
POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=
# Write-only pre-authenticated URL of the backup bucket, ending in /o/
BACKUP_PAR_URL=
# Healthchecks.io ping URL of the m7-server-backup check. The UUID is its only credential: treat it as a secret.
BACKUP_HEARTBEAT_URL=

# Filled in M7b, when the workflows arrive.
STRIPE_WEBHOOK_SECRET=
TELEGRAM_CHAT_ID=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
HEARTBEAT_URL=
INVOICE_EMAIL_FROM=
TELEGRAM_SEND_PDF=
